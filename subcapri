        const masMass = document.getElementById('mas-mass');
        const masSpring = document.getElementById('mas-spring');
        let masTime = 0;
        let masLastTimestamp = 0;
        let pRunning = true;

        function masParams() {
            const A = (masAmplitude ? Number(masAmplitude.value) : 80) / 100;
            const m = masMass ? Number(masMass.value) : 0.5;
            const k = masSpring ? Number(masSpring.value) : 10;
            const omega = Math.sqrt(k / m);
            const period = 2 * Math.PI / omega;
            const frequency = 1 / period;
            const x = A * Math.cos(omega * masTime);
            const v = -A * omega * Math.sin(omega * masTime);
            return { A, m, k, omega, period, frequency, x, v };
        }
        function fmt(value, digits=2) { return Number(value).toLocaleString('es-CO', {minimumFractionDigits: digits, maximumFractionDigits: digits}); }
        function updateMasReadouts() {
            const q = masParams();
            const put = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
            put('mas-amplitude-value', `${Math.round(q.A * 100)} cm`);
            put('mas-mass-value', `${fmt(q.m,1)} kg`);
            put('mas-spring-value', `${fmt(q.k,0)} N/m`);
            put('mas-period', `${fmt(q.period)} s`);
            put('mas-frequency', `${fmt(q.frequency)} Hz`);
            put('mas-position', `${q.x >= 0 ? '+' : ''}${fmt(q.x)} m`);
            put('mas-velocity', `${q.v >= 0 ? '+' : ''}${fmt(q.v)} m/s`);
            put('mas-explain', `Con estos valores, ω = ${fmt(q.omega)} rad/s. Al aumentar la masa, T crece; al aumentar k, T disminuye. La amplitud modifica la distancia recorrida, pero no el periodo del modelo ideal.`);
            const btn = document.getElementById('mas-play');
            if (btn) btn.textContent = pRunning ? '⏸ Pausar' : '▶ Continuar';
        }
        function togglePendulum() { pRunning = !pRunning; masLastTimestamp = 0; updateMasReadouts(); }
        function resetPendulum() { masTime = 0; masLastTimestamp = 0; updateMasReadouts(); }

        function drawSpring(ctx, x1, y, x2, coils=14, amp=12) {
            ctx.beginPath(); ctx.moveTo(x1, y);
            const length = x2 - x1;
            for (let i=1; i<coils; i++) {
                const x = x1 + length * i / coils;
                ctx.lineTo(x, y + (i % 2 ? -amp : amp));
            }
            ctx.lineTo(x2, y); ctx.stroke();
        }
        function drawPendulum(timestamp) {
            if (!pCanvas || !pCtx) return;
            const dt = masLastTimestamp ? Math.min((timestamp - masLastTimestamp) / 1000, 0.04) : 0;
            masLastTimestamp = timestamp;
            if (pRunning) masTime += dt;
            const q = masParams();
            const ctx = pCtx;
            const w = pCanvas.width, h = pCanvas.height;
            ctx.clearRect(0, 0, w, h);
            const y = Math.round(h * 0.47);
            const wallX = 48;
            const centerX = Math.round(w * 0.59);
            const scale = Math.min(170, w * 0.24);
            const massX = centerX + q.x * scale;
            // Subtle grid and track
            ctx.strokeStyle = 'rgba(148,163,184,0.14)'; ctx.lineWidth = 1;
            for (let gx=0; gx<w; gx+=40) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx,h); ctx.stroke(); }
            for (let gy=0; gy<h; gy+=40) { ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(w,gy); ctx.stroke(); }
            // Fixed wall and support
            ctx.fillStyle = '#475569'; ctx.fillRect(wallX-18, y-54, 18, 108);
            ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 2;
            for (let j=0; j<6; j++) { ctx.beginPath(); ctx.moveTo(wallX-18,y-48+j*18); ctx.lineTo(wallX-28,y-38+j*18); ctx.stroke(); }
            // Equilibrium track and spring
            ctx.strokeStyle = 'rgba(34,211,238,.5)'; ctx.setLineDash([6,6]); ctx.beginPath(); ctx.moveTo(centerX,y-48); ctx.lineTo(centerX,y+62); ctx.stroke(); ctx.setLineDash([]);
            ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 3;
            drawSpring(ctx, wallX, y, massX-27, 16, 11);
            // mass block
            const bw = 54, bh = 54;
            const gradient = ctx.createLinearGradient(massX-bw/2,y-bh/2,massX+bw/2,y+bh/2);
            gradient.addColorStop(0,'#fb7185'); gradient.addColorStop(1,'#be123c');
            ctx.fillStyle = gradient; ctx.shadowColor = '#fb7185'; ctx.shadowBlur = 18;
            ctx.beginPath(); ctx.roundRect(massX-bw/2,y-bh/2,bw,bh,10); ctx.fill(); ctx.shadowBlur = 0;
            ctx.strokeStyle = '#ffe4e6'; ctx.lineWidth = 2; ctx.stroke();
            // markers and labels
            ctx.font = 'bold 15px Rajdhani, sans-serif'; ctx.fillStyle = '#a5f3fc'; ctx.fillText('EQUILIBRIO', centerX-42, y+83);
            ctx.fillStyle = '#fda4af'; ctx.fillText(`x = ${q.x >= 0 ? '+' : ''}${fmt(q.x)} m`, 18, 28);
            ctx.fillStyle = '#cbd5e1'; ctx.fillText(`T = ${fmt(q.period)} s`, 18, 49);
            ctx.fillText(`f = ${fmt(q.frequency)} Hz`, 18, 70);
            ctx.fillStyle = '#94a3b8'; ctx.font = '12px Rajdhani, sans-serif';
            ctx.fillText('RESORTE', wallX+5, y-66); ctx.fillText('MASA', massX-20, y+43);
            // displacement arrow
            ctx.strokeStyle = '#facc15'; ctx.fillStyle = '#facc15'; ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(centerX,y-76); ctx.lineTo(massX,y-76); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(massX,y-76); ctx.lineTo(massX-(q.x>=0?8:-8),y-82); ctx.lineTo(massX-(q.x>=0?8:-8),y-70); ctx.closePath(); ctx.fill();
            // displacement vs time trace at bottom
            const plotY = h-38, plotX=18, plotW=w-36, plotH=22;
            ctx.strokeStyle='rgba(148,163,184,.35)'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(plotX,plotY); ctx.lineTo(plotX+plotW,plotY); ctx.stroke();
            ctx.strokeStyle='#c084fc'; ctx.lineWidth=2; ctx.beginPath();
            for(let i=0;i<=plotW;i++) { const t=masTime-q.period*2 + (i/plotW)*q.period*2; const yy=plotY-(q.A/1.2)*plotH*Math.cos(q.omega*t); if(i===0)ctx.moveTo(plotX+i,yy);else ctx.lineTo(plotX+i,yy); }
            ctx.stroke();
            updateMasReadouts();
            requestAnimationFrame(drawPendulum);
        }
        [masAmplitude,masMass,masSpring].forEach(el => { if (el) el.addEventListener('input', updateMasReadouts); });
        updateMasReadouts();
        requestAnimationFrame(drawPendulum);

        // CYBER ARCADE: modo hackeo con esferas de fórmulas matemáticas y físicas
        const gCanvas = document.getElementById('gameCanvas');
        const gCtx = gCanvas ? gCanvas.getContext('2d') : null;
        let playerX = 220;
        let bullets = [];
        let enemies = [];
        let score = 0;
        let gameLoopId = null;
        let gameLives = 3;
        let gameRunning = false;
        let matrixDrops = [];
        const formulaPool = ['F = ma', 'E = mc²', 'v = d/t', 'a = Δv/t', 'V = I·R', 'P = V·I', 'ΣF = 0', 'x² + y²', 'π ≈ 3.14', 'a² + b²', '√x', 'lim f(x)', '∫ f(x)dx', 'sin θ', 'g = 9.8', 'W = F·d'];

        function initMatrix() {
            matrixDrops = Array.from({length: 42}, () => ({x: Math.random()*gCanvas.width, y: Math.random()*gCanvas.height, speed: 0.5+Math.random()*1.5, glyph: Math.random() > .5 ? '1' : '0'}));
        }
        if (gCanvas) initMatrix();

        function startGame() {
            score = 0; bullets = []; enemies = []; playerX = gCanvas.width / 2 - 15;
            gameLives = 3; gameRunning = true;
            document.getElementById('gameScore').innerText = score;
            document.getElementById('gameLives').innerText = '⚡⚡⚡';
            if (gameLoopId) cancelAnimationFrame(gameLoopId);
            updateGame();
        }

        window.addEventListener('keydown', (e) => {
            const tag = (e.target && e.target.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) return;
            if (!gameRunning) return;
            if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a') { playerX = Math.max(8, playerX - 24); e.preventDefault(); }
            if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd') { playerX = Math.min(gCanvas.width - 38, playerX + 24); e.preventDefault(); }
            if (e.key === ' ') {
                e.preventDefault();
                bullets.push({x: playerX + 15, y: gCanvas.height - 40});
                if (typeof playSfx === 'function') playSfx('laser');
            }
        });

        // También permite mover la nave con clic/tacto sobre el área del juego.
        if (gCanvas) {
            gCanvas.addEventListener('pointerdown', (e) => {
                if (!gameRunning) return;
                const rect = gCanvas.getBoundingClientRect();
                playerX = Math.max(8, Math.min(gCanvas.width - 38, (e.clientX - rect.left) * gCanvas.width / rect.width - 15));
                bullets.push({x: playerX + 15, y: gCanvas.height - 40});
            });
        }

        function drawHackBackground() {
            gCtx.fillStyle = '#020617'; gCtx.fillRect(0, 0, gCanvas.width, gCanvas.height);
            gCtx.strokeStyle = 'rgba(0,240,255,.09)'; gCtx.lineWidth = 1;
            for (let x=0; x<gCanvas.width; x+=24) { gCtx.beginPath(); gCtx.moveTo(x,0); gCtx.lineTo(x,gCanvas.height); gCtx.stroke(); }
            for (let y=0; y<gCanvas.height; y+=24) { gCtx.beginPath(); gCtx.moveTo(0,y); gCtx.lineTo(gCanvas.width,y); gCtx.stroke(); }
            gCtx.font = '10px monospace';
            matrixDrops.forEach(d => { gCtx.fillStyle = 'rgba(34,197,94,.35)'; gCtx.fillText(d.glyph,d.x,d.y); d.y += d.speed; if (d.y > gCanvas.height) { d.y=0; d.x=Math.random()*gCanvas.width; } });
            gCtx.fillStyle = '#00f0ff'; gCtx.font = 'bold 10px monospace'; gCtx.fillText('BRECHA DE SEGURIDAD // FORMULAS DETECTADAS', 10, 16);
        }

        function drawPlayer() {
            const y = gCanvas.height - 30;
            gCtx.save(); gCtx.shadowBlur = 18; gCtx.shadowColor = '#00f0ff';
            gCtx.fillStyle = '#00f0ff'; gCtx.strokeStyle = '#d1ffff'; gCtx.lineWidth = 2;
            gCtx.beginPath(); gCtx.moveTo(playerX+15,y-17); gCtx.lineTo(playerX+30,y+8); gCtx.lineTo(playerX+15,y+2); gCtx.lineTo(playerX,y+8); gCtx.closePath(); gCtx.fill(); gCtx.stroke();
            gCtx.restore();
            gCtx.fillStyle='#22c55e'; gCtx.font='9px monospace'; gCtx.textAlign='center'; gCtx.fillText('HACKER',playerX+15,y+17); gCtx.textAlign='left';
        }

        function updateGame() {
            if (!gameRunning || !gCanvas || !gCtx) return;
            drawHackBackground(); drawPlayer();
            if (Math.random() < 0.026 && enemies.length < 8) {
                const formula = formulaPool[Math.floor(Math.random()*formulaPool.length)];
                enemies.push({x: 28 + Math.random()*(gCanvas.width-56), y: 28, r: 23, formula, speed: 0.75 + Math.random()*0.7, phase: Math.random()*6});
            }
            for (let bi=bullets.length-1; bi>=0; bi--) {
                const b=bullets[bi]; b.y-=7;
                gCtx.save(); gCtx.shadowBlur=12; gCtx.shadowColor='#ff2bd6'; gCtx.fillStyle='#ff2bd6'; gCtx.fillRect(b.x-2,b.y,4,13); gCtx.restore();
                if (b.y < -10) bullets.splice(bi,1);
            }
            for (let ei=enemies.length-1; ei>=0; ei--) {
                const en=enemies[ei]; en.y += en.speed; en.x += Math.sin(en.y/22+en.phase)*0.55;
                gCtx.save(); gCtx.shadowBlur=16; gCtx.shadowColor='#ffe600';
                gCtx.fillStyle='rgba(255,230,0,.12)'; gCtx.strokeStyle='#ffe600'; gCtx.lineWidth=2;
                gCtx.beginPath(); gCtx.arc(en.x,en.y,en.r,0,Math.PI*2); gCtx.fill(); gCtx.stroke();
                gCtx.strokeStyle='rgba(255,230,0,.5)'; gCtx.beginPath(); gCtx.arc(en.x,en.y,en.r-5,0,Math.PI*2); gCtx.stroke();
                gCtx.fillStyle='#ffffff'; gCtx.font = en.formula.length > 8 ? 'bold 8px monospace' : 'bold 10px monospace'; gCtx.textAlign='center'; gCtx.textBaseline='middle'; gCtx.fillText(en.formula,en.x,en.y); gCtx.restore();
                let hit=false;
                for (let bi=bullets.length-1; bi>=0; bi--) {
                    const b=bullets[bi];
                    if (Math.hypot(b.x-en.x,b.y-en.y) < en.r+5) {
                        enemies.splice(ei,1); bullets.splice(bi,1); score+=10;
                        document.getElementById('gameScore').innerText=score;
                        if (typeof playSfx === 'function') playSfx('powerup');
                        hit=true; break;
                    }
                }
                if (hit) continue;
                if (en.y > gCanvas.height-48 && Math.abs(en.x-(playerX+15)) < en.r+10) {
                    enemies.splice(ei,1); gameLives--;
                    document.getElementById('gameLives').innerText='⚡'.repeat(Math.max(0,gameLives));
                    if (gameLives<=0) {
                        gameRunning=false; gCtx.fillStyle='rgba(2,6,23,.88)'; gCtx.fillRect(0,0,gCanvas.width,gCanvas.height);
                        gCtx.textAlign='center'; gCtx.fillStyle='#ff2bd6'; gCtx.font='bold 24px monospace'; gCtx.fillText('SISTEMA COMPROMETIDO',gCanvas.width/2,gCanvas.height/2-8);
                        gCtx.fillStyle='#00f0ff'; gCtx.font='12px monospace'; gCtx.fillText('Créditos obtenidos: '+score+' · Reinicia para volver a hackear',gCanvas.width/2,gCanvas.height/2+18); gCtx.textAlign='left'; return;
                    }
                } else if (en.y > gCanvas.height+30) enemies.splice(ei,1);
            }
            gameLoopId=requestAnimationFrame(updateGame);
        }

        // Pantalla inicial temática para que el arcade ya parezca una terminal hackeada.
        if (gCanvas && gCtx) {
            drawHackBackground();
            gCtx.textAlign='center'; gCtx.fillStyle='#00f0ff'; gCtx.font='bold 22px monospace'; gCtx.fillText('CYBER BREACH',gCanvas.width/2,gCanvas.height/2-22);
            gCtx.fillStyle='#22c55e'; gCtx.font='12px monospace'; gCtx.fillText('FORMULAS ENCRIPTADAS DETECTADAS',gCanvas.width/2,gCanvas.height/2+4);
            gCtx.fillStyle='#ff2bd6'; gCtx.font='11px monospace'; gCtx.fillText('INICIA EL PROTOCOLO PARA DESBLOQUEAR',gCanvas.width/2,gCanvas.height/2+27); gCtx.textAlign='left';
        }

    </script>
