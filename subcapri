        function addCapriMessage(who, text, isUser = false) {
            const msgContainer = document.getElementById('capri-messages');
            if (!msgContainer) return null;
            const bubble = document.createElement('div');
            bubble.className = isUser ? 'flex justify-end' : 'flex items-start gap-2';
            const box = document.createElement('div');
            box.className = isUser
                ? 'bg-cyan-950/80 border border-cyan-500/50 p-2.5 rounded-xl rounded-tr-none max-w-[85%] space-y-1 text-right'
                : 'bg-pink-950/80 border border-pink-500/50 p-2.5 rounded-xl rounded-tl-none max-w-[90%] space-y-1';
            const label = document.createElement('p');
            label.className = isUser
                ? 'font-bold text-cyan-400 font-cyber text-[10px]'
                : 'font-bold text-pink-400 font-cyber text-[10px]';
            label.textContent = who + ':';
            const content = document.createElement('p');
            content.className = 'whitespace-pre-line text-white';
            content.textContent = text;
            box.append(label, content);
            bubble.appendChild(box);
            msgContainer.appendChild(bubble);
            msgContainer.scrollTop = msgContainer.scrollHeight;
            return content;
        }

        async function sendCapriMessage() {
            const input = document.getElementById('capri-input');
            const sendButton = document.querySelector('#capri-chat-box button[onclick*="sendCapriMessage"]');
            const userText = input ? input.value.trim() : '';
            if (!userText) return;

            const priorHistory = capriHistory.slice(-10);
            capriHistory.push({ role: 'user', content: userText });
            addCapriMessage('TÚ', userText, true);
            input.value = '';
            if (sendButton) sendButton.disabled = true;
            const replyEl = addCapriMessage('CAPRI', 'Analizando tu pregunta…');
            if (replyEl) replyEl.setAttribute('aria-live', 'polite');

            try {
                const response = await fetch('/.netlify/functions/capri', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ question: userText, history: priorHistory })
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(data.error || 'Capri no pudo conectarse al servicio de IA.');
                }
                const finalAnswer = data.answer || 'No recibí una respuesta. Inténtalo de nuevo.';
                if (replyEl) replyEl.textContent = finalAnswer;
                capriHistory.push({ role: 'assistant', content: finalAnswer });
                if (capriHistory.length > 10) capriHistory.splice(0, capriHistory.length - 10);
            } catch (error) {
                const detail = error && error.message ? error.message : 'Error de conexión desconocido.';
                if (replyEl) {
                    replyEl.textContent = 'Capri AI no pudo responder. ' + detail + ' Revisa que abras la web desde su dirección https://…netlify.app (no desde un archivo local), que la función capri esté desplegada y que OPENAI_API_KEY esté configurada en Netlify. Después de cambiar la variable, vuelve a desplegar el sitio.';
                }
                console.error('Error de Capri AI:', error);
            } finally {
                if (sendButton) sendButton.disabled = false;
                if (input) input.focus();
                playSfx('pop');
            }
        }

