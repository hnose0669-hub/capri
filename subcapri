        // Three.js 3D Cyberpunk Wireframe City Simulation
        const bgCanvas = document.getElementById('bg3d');
        if (window.THREE) {
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas: bgCanvas, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);

        // Cyberpunk Wireframe Grid Plane
        const gridHelper = new THREE.GridHelper(200, 40, 0x00f0ff, 0xff0055);
        gridHelper.position.y = -15;
        scene.add(gridHelper);

        const geometry = new THREE.IcosahedronGeometry(12, 1);
        const material = new THREE.MeshBasicMaterial({ color: 0x00f0ff, wireframe: true });
        const cyberCore = new THREE.Mesh(geometry, material);
        scene.add(cyberCore);

        camera.position.z = 35;

        function animate3d() {
            requestAnimationFrame(animate3d);
            cyberCore.rotation.x += 0.006;
            cyberCore.rotation.y += 0.009;
            gridHelper.position.z = (gridHelper.position.z + 0.2) % 5;
            renderer.render(scene, camera);
